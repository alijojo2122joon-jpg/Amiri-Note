<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: no action bar, Compose draws everything. Dark background
         so there is no white flash before Compose sets the real theme. -->
    <style name="Theme.AmiriNote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bootstrap_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
